openapi: 3.0.4
info:
  title: BotIQ ITSM API - Subset - Subset
  description: ITSM incident management APIs used by the M365 Copilot ITSM Agent.
  version: 1.0.0
servers:
  - url: https://bmfunitsmuat-gdbtbcb5bnaugddf.centralindia-01.azurewebsites.net/api
    description: Azure Functions base URL for the ITSM backend
paths:
  /validate_sso_token_auth_api:
    post:
      summary: Authenticate the signed-in user and retrieve accessible accounts
      description: >
        Validates the Microsoft 365 SSO authentication code and returns the
        authenticated user's access token, account scope, and all accessible
        accounts. Always call this first before creating an incident to identify
        the accounts the user can create incidents for. Use the returned
        account_name for account selection and the corresponding account_id
        when creating the incident. If only one account is returned, use it
        automatically without asking the user. If multiple accounts are returned
        and the user has not specified one, ask the user to choose an account.
      operationId: validateSsoTokenAndGetAccounts
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - sso_auth_code
              properties:
                sso_auth_code:
                  type: string
                  description: Microsoft 365 SSO authorization code.
      responses:
        "200":
          description: User authenticated successfully.
          content:
            application/json:
              schema:
                type: object
                properties:
                  status_code:
                    type: integer
                    example: 200
                  status_description:
                    type: string
                    example: SUCCESS
                  error_message:
                    type: string
                    example: ""
                  response_body:
                    type: object
                    properties:
                      access_token:
                        type: string
                      refresh_token:
                        type: string
                      email:
                        type: string
                      full_name:
                        type: string
                      account_scope:
                        type: string
                        example: LIST
                      accounts:
                        type: array
                        items:
                          type: object
                          properties:
                            account_id:
                              type: string
                              example: 96dfbadc-079a-4d32-80a7-c4235d3173a3
                            account_name:
                              type: string
                              example: Naffco
                            user_role:
                              type: string
                              example: Admin
      x-openai-isConsequential: false

  /create_incident_incident_api:
    post:
      summary: Create a new ITSM incident
      description: >
        Creates a new ITSM incident after all mandatory information has been
        collected. Before calling this operation, ensure title, description,
        account, and asset_id are available. Use Medium as the default priority,
        L2 as the default support tier, and Copilot as the intake channel unless
        the user explicitly specifies different values. If only one authenticated
        account exists, use it automatically. If multiple accounts exist and the
        user has not selected one, ask them to choose. Set
        requester_user_account_id to the selected account_id.
      operationId: createIncident
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - title
                - description
                - priority
                - support_tier
                - intake_channel
                - asset_id
                - requester_user_account_id
              properties:
                title:
                  type: string
                  description: Concise title of the incident.
                description:
                  type: string
                  description: Detailed description of the issue.
                priority:
                  type: string
                  enum:
                    - Low
                    - Medium
                    - High
                    - Critical
                  example: Medium
                support_tier:
                  type: string
                  enum:
                    - L1
                    - L2
                    - L3
                  example: L2
                intake_channel:
                  type: string
                  example: Copilot
                asset_id:
                  type: string
                  description: Asset identifier related to the incident.
                account_id:
                  type: string
                  nullable: true
                  description: Required only for Leadership users.
                requester_user_account_id:
                  type: string
                  description: Pass the selected account_id.
                auto_assign:
                  type: boolean
                  default: false
      responses:
        "201":
          description: Incident created successfully.
          content:
            application/json:
              schema:
                type: object
                properties:
                  status_code:
                    type: integer
                    example: 201
                  status_description:
                    type: string
                    example: CREATED
                  error_message:
                    type: string
                    example: ""
                  response_body:
                    type: object
                    properties:
                      incident_id:
                        type: string
                      incident_number:
                        type: string
                        example: INC-000482
                      incident_status:
                        type: string
                        example: Unassigned
                      assigned_engineer_user_account_id:
                        type: string
                        nullable: true
      security:
        - bearerAuth:
            - write
      x-openai-isConsequential: true
components:
  securitySchemes:
    bearerAuth:
      type: oauth2
      flows:
        authorizationCode:
          authorizationUrl: https://bmfunitsmuat-gdbtbcb5bnaugddf.centralindia-01.azurewebsites.net/api/oauth_authorize_api
          tokenUrl: https://bmfunitsmuat-gdbtbcb5bnaugddf.centralindia-01.azurewebsites.net/api/oauth_token_api
          refreshUrl: https://bmfunitsmuat-gdbtbcb5bnaugddf.centralindia-01.azurewebsites.net/api/oauth_token_api
          scopes:
            read: Read incidents and SLA data
            write: Create and update incidents