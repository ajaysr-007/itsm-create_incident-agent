{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "BotIQ",
    "websiteUrl": "https://bmfunitsmuat-gdbtbcb5bnaugddf.centralindia-01.azurewebsites.net",
    "privacyUrl": "https://bmfunitsmuat-gdbtbcb5bnaugddf.centralindia-01.azurewebsites.net/privacy",
    "termsOfUseUrl": "https://bmfunitsmuat-gdbtbcb5bnaugddf.centralindia-01.azurewebsites.net/termofuse"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "ITSM Incident Agent${{APP_NAME_SUFFIX}}",
    "full": "BotIQ ITSM Create Incident Agent"
  },
  "description": {
    "short": "Create and manage ITSM incidents via Copilot",
    "full": "A Microsoft 365 Copilot declarative agent that authenticates users and creates ITSM incidents through the BotIQ ITSM backend."
